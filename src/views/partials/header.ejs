<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %> | PokeTrack</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="header-content">
        <div class="brand-lockup">
          <a class="brand-mark" href="/" aria-label="PokeTrack home">P</a>
          <div class="brand-copy">
            <a class="brand-name" href="/">PokeTrack</a>
            <p class="brand-subtitle">Pokemon card market workspace</p>
          </div>
        </div>
        <nav class="site-nav">
          <a class="<%= pageTitle === 'Dashboard' ? 'is-active' : '' %>" href="/">Dashboard</a>
          <a class="<%= pageTitle === 'Listings' ? 'is-active' : '' %>" href="/listings">Listings</a>
          <a class="<%= pageTitle === 'Sales' ? 'is-active' : '' %>" href="/sales">Sales</a>
          <a class="<%= pageTitle === 'Import External Snapshots' ? 'is-active' : '' %>" href="/external-snapshots/import">Import</a>
        </nav>
        <div class="header-actions">
          <a class="button button-dark header-cta" href="/cards/new">+ Add card</a>
