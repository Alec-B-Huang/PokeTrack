<%- include("partials/header", { pageTitle }) %>

<section class="panel">
  <div class="panel-header">
    <div>
      <p class="eyebrow">Card Detail</p>
      <h2><%= card.name %></h2>
      <p class="subtle-text"><%= card.setName %> • #<%= card.cardNumber %> • <%= card.condition %></p>
      <% if (card.condition === "Graded" && card.gradingCompany && card.grade) { %>
        <p class="subtle-text"><%= card.gradingCompany %> <%= card.grade %></p>
      <% } %>
    </div>
    <div class="stack-right">
      <p><strong>Owned:</strong> <%= card.ownedQuantity %></p>
      <p><strong>Avg Buy:</strong> <%= formatCurrency(card.averageBuyPrice) %></p>
      <div class="stack-actions">
        <form action="/cards/<%= card.id %>/external-snapshots/ebay/fetch" method="POST">
          <button class="button button-secondary" type="submit" <%= ebayConfigured ? "" : "disabled" %>>
            Fetch eBay Listings
          </button>
        </form>
        <a class="button" href="/cards/<%= card.id %>/prices/new">Add Price</a>
        <form
          action="/cards/<%= card.id %>/delete"
          method="POST"
          onsubmit="return confirm('Delete Card? This will permanently delete the card and all related manual price entries, external snapshots, and active listings.');"
        >
          <button class="button button-danger" type="submit">Delete Card</button>
        </form>
      </div>
    </div>
  </div>

  <% if (successMessage) { %>
    <section class="message success-message">
      <p><%= successMessage %></p>
    </section>
  <% } %>

  <% if (errorMessage) { %>
    <section class="message error-message">
      <p><%= errorMessage %></p>
    </section>
  <% } %>

  <% if (!ebayConfigured) { %>
    <section class="message info-message">
      <p>eBay credentials are not configured yet. Add values to your local <code>.env</code> file to enable live snapshot fetching.</p>
    </section>
  <% } %>
</section>

<section class="panel">
  <div class="panel-header">
    <div>
      <p class="eyebrow">eBay Snapshot</p>
      <h3>Latest eBay Snapshot</h3>
    </div>
    <p class="subtle-text">Stored separately from your manual price entries</p>
  </div>

  <% if (latestEbaySnapshot) { %>
    <div class="section-actions">
      <form
        action="/cards/<%= card.id %>/external-snapshots/reset"
        method="POST"
        onsubmit="return confirm('Reset all external snapshots for this card? This will also remove associated active eBay listings. Manual price entries will not be deleted.');"
      >
        <button class="button button-danger" type="submit">Reset External Snapshots For This Card</button>
      </form>
    </div>
  <% } %>

  <% if (!latestEbaySnapshot) { %>
    <div class="empty-state">
      <h4>No eBay snapshot yet</h4>
      <p>Use the fetch button to save an active-listing snapshot for this card.</p>
    </div>
  <% } else { %>
    <div class="metric-grid">
      <article class="metric-card">
        <p class="eyebrow">Snapshot Date</p>
        <h4><%= latestEbaySnapshot.snapshotDate %></h4>
      </article>
      <article class="metric-card">
        <p class="eyebrow">Listing Count</p>
        <h4><%= latestEbaySnapshot.listingCount %></h4>
      </article>
      <article class="metric-card">
        <p class="eyebrow">Lowest Price</p>
        <h4><%= formatCurrency(latestEbaySnapshot.lowestPrice) %></h4>
      </article>
      <article class="metric-card">
        <p class="eyebrow">Median Price</p>
        <h4><%= formatCurrency(latestEbaySnapshot.medianPrice) %></h4>
      </article>
    </div>

    <% if (marketSignal) { %>
      <section class="market-signal market-signal-<%= marketSignal.tone %>">
        <div class="market-signal-header">
          <h4><%= marketSignal.title %></h4>
          <p class="market-signal-change <%= marketSignal.tone %>"><%= formatPercent(marketSignal.percentChange) %></p>
        </div>
        <p><%= marketSignal.message %></p>
        <p class="subtle-text">
          Compared <%= marketSignal.latestSnapshot.snapshotDate %> against <%= marketSignal.previousSnapshot.snapshotDate %> using saved eBay active listing median prices only.
        </p>
      </section>
    <% } %>

    <div class="snapshot-meta">
      <p><strong>Query:</strong> <%= latestEbaySnapshot.searchQuery %></p>
      <p><strong>Notes:</strong> <%= latestEbaySnapshot.notes %></p>
    </div>
  <% } %>
</section>

<section class="panel">
  <div class="panel-header">
    <div>
      <p class="eyebrow">Sold Sales</p>
      <h3>Latest Sold Sales Snapshot</h3>
    </div>
    <p class="subtle-text">Imported sold comps stay separate from active listings</p>
  </div>

  <% if (!latestSoldSalesSnapshot) { %>
    <div class="empty-state">
      <h4>No sold-sales data imported yet.</h4>
    </div>
  <% } else { %>
    <div class="metric-grid sold-summary-grid">
      <article class="metric-card">
        <p class="eyebrow">Snapshot Date</p>
        <h4><%= latestSoldSalesSnapshot.snapshotDate %></h4>
      </article>
      <article class="metric-card">
        <p class="eyebrow">Source</p>
        <h4><%= latestSoldSalesSnapshot.source %></h4>
      </article>
      <article class="metric-card">
        <p class="eyebrow">Sale Count</p>
        <h4><%= latestSoldSalesSnapshot.saleCount %></h4>
      </article>
      <article class="metric-card">
        <p class="eyebrow">Lowest Sold</p>
        <h4><%= formatCurrency(latestSoldSalesSnapshot.lowestSalePrice) %></h4>
      </article>
      <article class="metric-card">
        <p class="eyebrow">Median Sold</p>
        <h4><%= formatCurrency(latestSoldSalesSnapshot.medianSalePrice) %></h4>
      </article>
      <article class="metric-card">
        <p class="eyebrow">Average Sold</p>
        <h4><%= formatCurrency(latestSoldSalesSnapshot.averageSalePrice) %></h4>
      </article>
      <article class="metric-card">
        <p class="eyebrow">Highest Sold</p>
        <h4><%= formatCurrency(latestSoldSalesSnapshot.highestSalePrice) %></h4>
      </article>
    </div>

    <% if (latestSoldSalesComps.length === 0) { %>
      <div class="empty-state">
        <h4>No sold-sales data imported yet.</h4>
      </div>
    <% } else { %>
      <div class="table-wrap sold-sales-table">
        <table>
          <thead>
            <tr>
              <th>Sold Date</th>
              <th>Title</th>
              <th>Sale Price</th>
              <th>Currency</th>
              <th>Condition</th>
              <th>Format</th>
              <th>Source / Link</th>
            </tr>
          </thead>
          <tbody>
            <% latestSoldSalesComps.forEach((sale) => { %>
              <tr>
                <td><%= sale.soldDate %></td>
                <td>
                  <strong><%= sale.title %></strong>
                  <% if (sale.notes) { %>
                    <div class="subtle-text"><%= sale.notes %></div>
                  <% } %>
                </td>
                <td><%= formatCurrency(sale.salePrice) %></td>
                <td><%= sale.currency %></td>
                <td><%= sale.listingCondition || "N/A" %></td>
                <td><%= sale.listingFormat || "N/A" %></td>
                <td>
                  <%= latestSoldSalesSnapshot.source %>
                  <% if (sale.listingUrl) { %>
                    <div class="subtle-text"><a href="<%= sale.listingUrl %>" target="_blank" rel="noreferrer">View source</a></div>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  <% } %>
</section>

<section class="panel">
  <div class="panel-header">
    <div>
      <p class="eyebrow">Active Listings</p>
      <h3>Active eBay Listings</h3>
    </div>
    <p class="subtle-text">
      <%= latestEbaySnapshot ? `From the latest eBay snapshot on ${latestEbaySnapshot.snapshotDate}` : "No eBay snapshot saved yet" %>
    </p>
  </div>

  <% if (latestEbayActiveListings.length === 0) { %>
    <div class="empty-state">
      <h4>No active listings found</h4>
      <p>Save an eBay snapshot with listing data to populate this section.</p>
    </div>
  <% } else { %>
    <div class="listing-grid">
      <% latestEbayActiveListings.slice(0, 6).forEach((listing) => { %>
        <article class="listing-card">
          <h4><%= listing.title %></h4>
          <p><strong>Price:</strong> <%= formatCurrency(listing.price) %> <%= listing.currency || "" %></p>
          <p><strong>Condition:</strong> <%= listing.listingCondition || "N/A" %></p>
          <p><strong>Seller:</strong> <%= listing.sellerUsername || "N/A" %></p>
          <p><strong>Item ID:</strong> <%= listing.externalItemId || "N/A" %></p>
          <% if (listing.listingUrl) { %>
            <p><a href="<%= listing.listingUrl %>" target="_blank" rel="noreferrer">View listing</a></p>
          <% } %>
        </article>
      <% }) %>
    </div>

    <% if (latestEbayActiveListings.length > 6) { %>
      <details class="listing-details">
        <summary>View More (<%= latestEbayActiveListings.length - 6 %> more listing(s))</summary>
        <div class="listing-grid listing-grid-extra">
          <% latestEbayActiveListings.slice(6).forEach((listing) => { %>
            <article class="listing-card">
              <h4><%= listing.title %></h4>
              <p><strong>Price:</strong> <%= formatCurrency(listing.price) %> <%= listing.currency || "" %></p>
              <p><strong>Condition:</strong> <%= listing.listingCondition || "N/A" %></p>
              <p><strong>Seller:</strong> <%= listing.sellerUsername || "N/A" %></p>
              <p><strong>Item ID:</strong> <%= listing.externalItemId || "N/A" %></p>
              <% if (listing.listingUrl) { %>
                <p><a href="<%= listing.listingUrl %>" target="_blank" rel="noreferrer">View listing</a></p>
              <% } %>
            </article>
          <% }) %>
        </div>
      </details>
    <% } %>
  <% } %>
</section>

<section class="panel">
  <div class="panel-header">
    <div>
      <p class="eyebrow">Chart</p>
      <h3>External Price Trend</h3>
    </div>
    <p class="subtle-text">Median and lowest saved external snapshot prices over time</p>
  </div>

  <% if (externalSnapshotHistory.length === 0) { %>
    <div class="empty-state">
      <h4>No external chart data yet</h4>
      <p>Fetch or import your first external snapshot to start visualizing saved price history.</p>
    </div>
  <% } else { %>
    <div class="chart-shell">
      <canvas id="externalSnapshotChart" aria-label="External snapshot price history chart"></canvas>
    </div>
  <% } %>
</section>

<section class="panel">
  <div class="panel-header">
    <div>
      <p class="eyebrow">History</p>
      <h3>External Snapshot History</h3>
    </div>
    <p class="subtle-text"><%= externalSnapshotHistory.length %> snapshot(s)</p>
  </div>

  <% if (externalSnapshotHistory.length === 0) { %>
    <div class="empty-state">
      <h4>No external history yet</h4>
      <p>Fetched or imported snapshots will appear here over time.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Source</th>
            <th>Listings</th>
            <th>Lowest</th>
            <th>Median</th>
            <th>Query</th>
            <th>Notes</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% externalSnapshotHistory.forEach((snapshot) => { %>
            <tr>
              <td><%= snapshot.snapshotDate %></td>
              <td><%= snapshot.source %></td>
              <td><%= snapshot.listingCount %></td>
              <td><%= formatCurrency(snapshot.lowestPrice) %></td>
              <td><%= formatCurrency(snapshot.medianPrice) %></td>
              <td><%= snapshot.searchQuery %></td>
              <td><%= snapshot.notes || "—" %></td>
              <td>
                <form
                  action="/external-snapshots/<%= snapshot.id %>/delete"
                  method="POST"
                  onsubmit="return confirm('Delete this external snapshot? Associated active eBay listings from this snapshot will also be removed.');"
                >
                  <button class="button button-danger button-small" type="submit">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="panel">
  <div class="panel-header">
    <div>
      <p class="eyebrow">Manual Tracking</p>
      <h3>Manual Price History</h3>
    </div>
  </div>

  <% if (card.priceHistory.length === 0) { %>
    <div class="empty-state">
      <h4>No price entries yet</h4>
      <p>Add the first price entry to start tracking this card.</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Raw Price</th>
            <th>PSA 9</th>
            <th>PSA 10</th>
            <th>Notes</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% card.priceHistory.forEach((entry) => { %>
            <tr>
              <td><%= entry.entryDate %></td>
              <td><%= formatCurrency(entry.rawPrice) %></td>
              <td><%= formatCurrency(entry.psa9Price) %></td>
              <td><%= formatCurrency(entry.psa10Price) %></td>
              <td><%= entry.notes || "—" %></td>
              <td>
                <form
                  action="/prices/<%= entry.id %>/delete"
                  method="POST"
                  onsubmit="return confirm('Delete this manual price entry? This only removes the selected manual row.');"
                >
                  <button class="button button-danger button-small" type="submit">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<% if (externalSnapshotHistory.length > 0) { %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    const externalChartData = <%- JSON.stringify(externalChartData) %>;
    const chartCanvas = document.getElementById("externalSnapshotChart");

    if (chartCanvas && window.Chart) {
      new Chart(chartCanvas, {
        type: "line",
        data: {
          labels: externalChartData.labels,
          datasets: [
            {
              label: "Median External Price",
              data: externalChartData.medianPrices,
              borderColor: "#d64c2f",
              backgroundColor: "rgba(214, 76, 47, 0.16)",
              borderWidth: 3,
              pointRadius: 4,
              pointHoverRadius: 5,
              tension: 0.25
            },
            {
              label: "Lowest External Price",
              data: externalChartData.lowestPrices,
              borderColor: "#4368ad",
              backgroundColor: "rgba(67, 104, 173, 0.12)",
              borderWidth: 2,
              pointRadius: 4,
              pointHoverRadius: 5,
              tension: 0.25
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            mode: "index",
            intersect: false
          },
          scales: {
            y: {
              beginAtZero: false,
              ticks: {
                callback(value) {
                  return new Intl.NumberFormat("en-US", {
                    style: "currency",
                    currency: "USD"
                  }).format(value);
                }
              }
            }
          },
          plugins: {
            tooltip: {
              callbacks: {
                afterBody(items) {
                  const firstItem = items[0];

                  if (!firstItem) {
                    return "";
                  }

                  const listingCount = externalChartData.listingCounts[firstItem.dataIndex];
                  const source = externalChartData.sources[firstItem.dataIndex];
                  return [`Source: ${source}`, `Listing count: ${listingCount}`];
                }
              }
            }
          }
        }
      });
    }
  </script>
<% } %>

<%- include("partials/footer") %>
