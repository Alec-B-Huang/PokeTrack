<%- include("partials/header", { pageTitle }) %>

<section class="panel form-panel">
  <div class="panel-header">
    <div>
      <p class="eyebrow">Watchlist</p>
      <h2>Add a Card</h2>
    </div>
    <p>Save the basics first, then log prices over time.</p>
  </div>

  <% if (errors.length > 0) { %>
    <div class="message error-message">
      <ul>
        <% errors.forEach((error) => { %>
          <li><%= error %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form class="form-grid" action="/cards" method="POST">
    <label>
      Card Name
      <input type="text" name="name" value="<%= formData.name %>" placeholder="Pikachu" required />
    </label>

    <label>
      Set Name
      <input type="text" name="setName" value="<%= formData.setName %>" placeholder="Base Set" required />
    </label>

    <label>
      Card Number
      <input type="text" name="cardNumber" value="<%= formData.cardNumber %>" placeholder="58/102" required />
    </label>

    <label>
      Condition
      <select id="condition" name="condition" required>
        <% conditionOptions.forEach((option) => { %>
          <option value="<%= option %>" <%= option === formData.condition ? "selected" : "" %>><%= option %></option>
        <% }) %>
      </select>
    </label>

    <div id="graded-fields" class="graded-fields" <%= formData.condition === "Graded" ? "" : "hidden" %>>
      <label>
        Grading Company
        <select id="gradingCompany" name="gradingCompany">
          <option value="">Select grading company</option>
          <% gradingCompanyOptions.forEach((option) => { %>
            <option value="<%= option %>" <%= option === formData.gradingCompany ? "selected" : "" %>><%= option %></option>
          <% }) %>
        </select>
      </label>

      <label>
        Grade
        <select id="grade" name="grade">
          <option value="">Select grade</option>
          <% gradeOptions.forEach((option) => { %>
            <option value="<%= option %>" <%= String(option) === String(formData.grade) ? "selected" : "" %>><%= option %></option>
          <% }) %>
        </select>
      </label>
    </div>

    <label>
      Owned Quantity
      <input type="number" name="ownedQuantity" value="<%= formData.ownedQuantity %>" min="0" step="1" required />
    </label>

    <label>
      Average Buy Price
      <input type="number" name="averageBuyPrice" value="<%= formData.averageBuyPrice %>" min="0" step="0.01" placeholder="12.50" required />
    </label>

    <div class="form-actions">
      <button class="button" type="submit">Save Card</button>
      <a class="button button-secondary" href="/">Back to Dashboard</a>
    </div>
  </form>
</section>

<script>
  const conditionField = document.getElementById("condition");
  const gradedFields = document.getElementById("graded-fields");
  const gradingCompanyField = document.getElementById("gradingCompany");
  const gradeField = document.getElementById("grade");

  function updateGradedFieldVisibility() {
    const isGraded = conditionField && conditionField.value === "Graded";

    if (gradedFields) {
      gradedFields.hidden = !isGraded;
    }

    if (gradingCompanyField) {
      gradingCompanyField.required = isGraded;
    }

    if (gradeField) {
      gradeField.required = isGraded;
    }
  }

  if (conditionField) {
    conditionField.addEventListener("change", updateGradedFieldVisibility);
    updateGradedFieldVisibility();
  }
</script>

<%- include("partials/footer") %>
